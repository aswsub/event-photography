---
// Using Unsplash placeholders for a more dynamic event/concert/dance feel
const photos = [
  { id: 1, url: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&q=80', alt: 'Concert Crowd' },
  { id: 2, url: 'https://images.unsplash.com/photo-1547153760-18fc86324498?w=800&q=80', alt: 'Dance Performance' },
  { id: 3, url: 'https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=800&q=80', alt: 'Live Event Lights' },
  { id: 4, url: 'https://images.unsplash.com/photo-1524368535928-5b5e00ddc76b?w=800&q=80', alt: 'Festival Stage' },
  { id: 5, url: 'https://images.unsplash.com/photo-1508214751196-bfdd4ca4ccaa?w=800&q=80', alt: 'DJ Setup' },
  { id: 6, url: 'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=800&q=80', alt: 'Nightlife Vibe' },
  { id: 7, url: 'https://images.unsplash.com/photo-1470229722913-7c092db62220?w=800&q=80', alt: 'Music Festival' },
  { id: 8, url: 'https://images.unsplash.com/photo-1533174000243-781b0a50fdd4?w=800&q=80', alt: 'Urban Dance' },
  { id: 9, url: 'https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?w=800&q=80', alt: 'Event Celebration' },
];
---

<section id="portfolio" class="gallery">
  {photos.map((photo) => (
    <div class="gallery-item">
      <img src={photo.url} alt={photo.alt} loading="lazy" />
      <div class="overlay">
        <span>{photo.alt}</span>
      </div>
    </div>
  ))}
</section>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    grid-gap: 1.5rem;
    padding: 2rem 0;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    background: #1a1a1a;
    /* Maintain aspect ratio somewhat but let grid handle flow */
    aspect-ratio: 1 / 1;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 10, 10, 0.7);
    color: var(--text-color);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(2px);
  }

  .gallery-item:hover .overlay {
    opacity: 1;
  }

  .overlay span {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent-color);
  }
</style>
