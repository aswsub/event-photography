---
// Using Picsum photos as placeholders for high quality photography
const photos = [
  { id: 1, url: 'https://picsum.photos/id/1018/800/600', alt: 'Nature Landscape' },
  { id: 2, url: 'https://picsum.photos/id/1015/800/800', alt: 'River Valley' },
  { id: 3, url: 'https://picsum.photos/id/1036/800/1000', alt: 'Snowy Mountains' },
  { id: 4, url: 'https://picsum.photos/id/1039/800/600', alt: 'Waterfall in Forest' },
  { id: 5, url: 'https://picsum.photos/id/1043/800/800', alt: 'Canyon' },
  { id: 6, url: 'https://picsum.photos/id/1044/800/600', alt: 'Forest Path' },
  { id: 7, url: 'https://picsum.photos/id/1047/800/1000', alt: 'City Architecture' },
  { id: 8, url: 'https://picsum.photos/id/1050/800/600', alt: 'Ocean Waves' },
  { id: 9, url: 'https://picsum.photos/id/1062/800/800', alt: 'Dog wrapped in blanket' },
];
---

<section id="portfolio" class="gallery">
  {photos.map((photo) => (
    <div class="gallery-item">
      <img src={photo.url} alt={photo.alt} loading="lazy" />
      <div class="overlay">
        <span>{photo.alt}</span>
      </div>
    </div>
  ))}
</section>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    grid-gap: 1.5rem;
    padding: 2rem 0;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    background: #eee;
    /* Maintain aspect ratio somewhat but let grid handle flow */
    aspect-ratio: 1 / 1;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gallery-item:hover .overlay {
    opacity: 1;
  }

  .overlay span {
    font-size: 1.2rem;
    font-weight: 300;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
</style>
