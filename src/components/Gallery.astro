---
export interface Props {
  photos: {
    id: number;
    url: string;
    alt: string;
  }[];
}

const { photos } = Astro.props;
---

<div class="gallery">
  {photos.map((photo) => (
    <div class="gallery-item">
      <div class="image-wrapper">
        <img src={photo.url} alt={photo.alt} loading="lazy" />
      </div>
      <div class="caption">{photo.alt}</div>
    </div>
  ))}
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 32px; /* spacing-xxxl */
  }

  .gallery-item {
    display: flex;
    flex-direction: column;
    gap: 16px; /* spacing-md */
  }

  .image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--rounded-md);
    overflow: hidden;
    background-color: var(--canvas-soft); /* placeholder bg */
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .caption {
    font-size: 16px; /* body-loose */
    font-weight: 350;
    color: var(--ink);
  }
</style>
