---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
---

<Layout>
	<section class="hero">
		<h1>Capturing the energy of the moment</h1>
		<p>Professional Event & Dance Photography. High-energy, dynamic, and unforgettable visuals for your next big event.</p>
	</section>

	<Gallery />

	<section id="contact" class="contact">
		<h2>Ready to create something amazing?</h2>
		<p>Book me for your next festival, dance performance, or private event.</p>
		<a href="mailto:booking@alexmercerphoto.com" class="btn">Book Now</a>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 6rem 0 4rem;
	}

	.hero h1 {
		font-size: 4rem;
		font-weight: 800;
		margin-bottom: 1.5rem;
		letter-spacing: -1.5px;
		line-height: 1.1;
		background: -webkit-linear-gradient(45deg, #fff, #888);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero p {
		font-size: 1.25rem;
		color: #aaa;
		max-width: 650px;
		margin: 0 auto;
		line-height: 1.7;
	}

	.contact {
		text-align: center;
		padding: 5rem 0;
		margin-top: 3rem;
		border-top: 1px solid var(--border-color);
	}

	.contact h2 {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 1rem;
		letter-spacing: -0.5px;
	}

	.contact p {
		color: #aaa;
		margin-bottom: 2.5rem;
		font-size: 1.1rem;
	}

	.btn {
		display: inline-block;
		padding: 1rem 2.5rem;
		background-color: var(--accent-color);
		color: #fff;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-weight: 600;
		font-size: 0.9rem;
		border-radius: 4px;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 20px rgba(255, 51, 102, 0.3);
	}
</style>
