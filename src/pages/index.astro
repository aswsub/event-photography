---
import Layout from '../layouts/Layout.astro';

const portfolios = [
	{
		title: 'Festivals & Concerts',
		link: '/portfolio/festivals',
		image: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&q=80',
	},
	{
		title: 'Dance & Performance',
		link: '/portfolio/dance',
		image: 'https://images.unsplash.com/photo-1547153760-18fc86324498?w=800&q=80',
	},
	{
		title: 'Private Events',
		link: '/portfolio/events',
		image: 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=800&q=80',
	}
];
---

<Layout>
	<section class="hero">
		<h1>Capturing the energy of the moment</h1>
		<p>Professional Event & Dance Photography. High-energy, dynamic, and unforgettable visuals for your next big event.</p>
	</section>

	<section id="galleries" class="portfolios">
		<h2>Featured Portfolios</h2>
		<div class="portfolio-grid">
			{portfolios.map((portfolio) => (
				<a href={portfolio.link} class="portfolio-card">
					<img src={portfolio.image} alt={portfolio.title} loading="lazy" />
					<div class="card-overlay">
						<h3>{portfolio.title}</h3>
					</div>
				</a>
			))}
		</div>
	</section>

	<section id="contact" class="contact">
		<h2>Ready to create something amazing?</h2>
		<p>Book me for your next festival, dance performance, or private event.</p>
		<a href="mailto:booking@alexmercerphoto.com" class="btn">Book Now</a>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 6rem 0 4rem;
	}

	.hero h1 {
		font-size: 4rem;
		font-weight: 800;
		margin-bottom: 1.5rem;
		letter-spacing: -1.5px;
		line-height: 1.1;
		background: -webkit-linear-gradient(45deg, #fff, #888);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero p {
		font-size: 1.25rem;
		color: #aaa;
		max-width: 650px;
		margin: 0 auto;
		line-height: 1.7;
	}

	.portfolios {
		padding: 4rem 0;
	}

	.portfolios h2 {
		text-align: center;
		font-size: 2.5rem;
		margin-bottom: 3rem;
		font-weight: 700;
	}

	.portfolio-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.portfolio-card {
		display: block;
		position: relative;
		border-radius: 8px;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		text-decoration: none;
		box-shadow: 0 10px 20px rgba(0,0,0,0.3);
	}

	.portfolio-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.portfolio-card:hover img {
		transform: scale(1.05);
	}

	.card-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
		padding: 2rem 1.5rem 1.5rem;
		color: #fff;
	}

	.card-overlay h3 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: 1px;
		transition: color 0.3s;
	}

	.portfolio-card:hover .card-overlay h3 {
		color: var(--accent-color);
	}

	.contact {
		text-align: center;
		padding: 5rem 0;
		margin-top: 3rem;
		border-top: 1px solid var(--border-color);
	}

	.contact h2 {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 1rem;
		letter-spacing: -0.5px;
	}

	.contact p {
		color: #aaa;
		margin-bottom: 2.5rem;
		font-size: 1.1rem;
	}

	.btn {
		display: inline-block;
		padding: 1rem 2.5rem;
		background-color: var(--accent-color);
		color: #fff;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-weight: 600;
		font-size: 0.9rem;
		border-radius: 4px;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 20px rgba(255, 51, 102, 0.3);
	}
</style>
