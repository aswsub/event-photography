---
import Layout from '../layouts/Layout.astro';

const portfolios = [
	{
		title: 'Festivals & Concerts',
		link: '/portfolio/festivals',
		image: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&q=80',
	},
	{
		title: 'Dance & Performance',
		link: '/portfolio/dance',
		image: 'https://images.unsplash.com/photo-1547153760-18fc86324498?w=800&q=80',
	},
	{
		title: 'Private Events',
		link: '/portfolio/events',
		image: 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=800&q=80',
	}
];
---

<Layout>
	<section class="hero">
		<div class="container">
			<h1>Capturing the energy of the moment</h1>
			<div class="hero-rule"></div>
			<p>Professional Event & Dance Photography. High-energy, dynamic, and unforgettable visuals for your next big event.</p>
		</div>
	</section>

	<section id="galleries" class="portfolios">
		<div class="container">
			<h2>Featured Portfolios</h2>
			<div class="portfolio-grid">
				{portfolios.map((portfolio) => (
					<a href={portfolio.link} class="portfolio-card">
						<div class="card-image-wrapper">
							<img src={portfolio.image} alt={portfolio.title} loading="lazy" />
						</div>
						<h3>{portfolio.title}</h3>
					</a>
				))}
			</div>
		</div>
	</section>

	<section id="contact" class="contact">
		<div class="container">
			<h2>Ready to create something amazing?</h2>
			<p>Book me for your next festival, dance performance, or private event.</p>
			<a href="mailto:booking@alexmercerphoto.com" class="btn">Book Now</a>
		</div>
	</section>
</Layout>

<style>
	.container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 5%;
	}

	.hero {
		background-color: var(--canvas-warm);
		padding: var(--spacing-section) 0;
		text-align: left;
	}

	.hero h1 {
		font-size: 40px; /* display-sans-lg */
		font-weight: 300;
		line-height: 1.2;
		max-width: 800px;
		margin-bottom: 24px;
	}

	.hero-rule {
		width: 40px;
		height: 4px;
		background-color: var(--accent-gold);
		margin-bottom: 24px;
	}

	.hero p {
		font-size: 24px; /* lead */
		font-weight: 400;
		line-height: 1.4;
		max-width: 800px;
		margin: 0;
	}

	.portfolios {
		background-color: var(--canvas-soft);
		padding: var(--spacing-section) 0;
	}

	.portfolios h2 {
		font-size: 24px; /* heading-lg */
		font-weight: 800;
		margin-bottom: 32px;
	}

	.portfolio-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.portfolio-card {
		display: block;
		text-decoration: none;
		background-color: var(--canvas);
		border: 1px solid var(--hairline);
		border-radius: var(--rounded-md);
		padding: 20px; /* spacing-xl ish */
		transition: background-color 0.2s ease;
	}

	.portfolio-card:hover {
		background-color: var(--canvas-soft);
	}

	.card-image-wrapper {
		width: 100%;
		aspect-ratio: 4 / 3;
		border-radius: var(--rounded-md);
		overflow: hidden;
		margin-bottom: 16px;
	}

	.card-image-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.portfolio-card h3 {
		margin: 0;
		font-size: 18px; /* heading-sm */
		font-weight: 800;
		color: var(--ink);
	}

	.contact {
		background-color: var(--canvas-tint);
		padding: var(--spacing-section) 0;
		text-align: left;
	}

	.contact h2 {
		font-size: 24px; /* heading-lg */
		font-weight: 800;
		margin-bottom: 16px;
	}

	.contact p {
		font-size: 16px;
		font-weight: 400;
		color: var(--ink);
		margin-bottom: 24px;
	}

	.btn {
		display: inline-block;
		padding: 10px 16px;
		background-color: var(--primary);
		color: var(--on-primary);
		text-decoration: none;
		font-weight: 500; /* label */
		font-size: 14px;
		border-radius: var(--rounded-xs);
		transition: background-color 0.2s ease;
	}

	.btn:hover {
		background-color: var(--primary-pressed);
	}
</style>
