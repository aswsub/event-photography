---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';

const photos = [
  { id: 1, url: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&q=80', alt: 'Concert Crowd' },
  { id: 2, url: 'https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=800&q=80', alt: 'Live Event Lights' },
  { id: 3, url: 'https://images.unsplash.com/photo-1524368535928-5b5e00ddc76b?w=800&q=80', alt: 'Festival Stage' },
  { id: 4, url: 'https://images.unsplash.com/photo-1508214751196-bfdd4ca4ccaa?w=800&q=80', alt: 'DJ Setup' },
  { id: 5, url: 'https://images.unsplash.com/photo-1470229722913-7c092db62220?w=800&q=80', alt: 'Music Festival' },
  { id: 6, url: 'https://images.unsplash.com/photo-1459749411175-04bf5292ceea?w=800&q=80', alt: 'Concert Fans' },
];
---

<Layout>
  <section class="hero">
    <div class="container">
      <h1>Festivals & Concerts</h1>
      <div class="hero-rule"></div>
      <p>Capturing the massive energy and unforgettable moments of live music events.</p>
    </div>
  </section>

  <section class="gallery-section">
    <div class="container">
      <Gallery photos={photos} />

      <div class="back-link">
        <a href="/" class="btn btn-secondary">Back to Home</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 5%;
  }

  .hero {
    background-color: var(--canvas-warm);
    padding: var(--spacing-section) 0;
  }

  .hero h1 {
    font-family: 'Georgia', serif;
    font-size: 56px; /* display-serif-xl */
    font-weight: 400;
    margin-bottom: 24px;
    line-height: 1.2;
  }

  .hero-rule {
    width: 40px;
    height: 4px;
    background-color: var(--accent-gold);
    margin-bottom: 24px;
  }

  .hero p {
    font-size: 24px; /* lead */
    font-weight: 400;
    line-height: 1.4;
    max-width: 800px;
    margin: 0;
  }

  .gallery-section {
    background-color: var(--canvas);
    padding: var(--spacing-section) 0;
  }

  .back-link {
    margin-top: 48px;
    text-align: left;
  }

  .btn-secondary {
    display: inline-block;
    padding: 10px 16px;
    background-color: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: var(--rounded-xs);
    font-weight: 500;
    font-size: 14px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn-secondary:hover {
    background-color: rgba(0,0,0,0.05);
  }
</style>