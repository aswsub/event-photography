---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';

const photos = [
  { id: 1, url: 'https://images.unsplash.com/photo-1547153760-18fc86324498?w=800&q=80', alt: 'Dance Performance' },
  { id: 2, url: 'https://images.unsplash.com/photo-1533174000243-781b0a50fdd4?w=800&q=80', alt: 'Urban Dance' },
  { id: 3, url: 'https://images.unsplash.com/photo-1508700929628-666bc8bd84ea?w=800&q=80', alt: 'Ballet Dancer' },
  { id: 4, url: 'https://images.unsplash.com/photo-1518834107812-67b0b7c58434?w=800&q=80', alt: 'Contemporary Dance' },
  { id: 5, url: 'https://images.unsplash.com/photo-1502318217862-aa4e294ba657?w=800&q=80', alt: 'Breakdance' },
  { id: 6, url: 'https://images.unsplash.com/photo-1541364983171-a8ba01e9d776?w=800&q=80', alt: 'Dance Studio' },
];
---

<Layout>
  <section class="hero">
    <div class="container">
      <h1>Dance & Performance</h1>
      <div class="hero-rule"></div>
      <p>Dynamic movement, raw emotion, and artistic expression frozen in time.</p>
    </div>
  </section>

  <section class="gallery-section">
    <div class="container">
      <Gallery photos={photos} />

      <div class="back-link">
        <a href="/" class="btn btn-secondary">Back to Home</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 5%;
  }

  .hero {
    background-color: var(--canvas-warm);
    padding: var(--spacing-section) 0;
  }

  .hero h1 {
    font-family: 'Georgia', serif;
    font-size: 56px; /* display-serif-xl */
    font-weight: 400;
    margin-bottom: 24px;
    line-height: 1.2;
  }

  .hero-rule {
    width: 40px;
    height: 4px;
    background-color: var(--accent-gold);
    margin-bottom: 24px;
  }

  .hero p {
    font-size: 24px; /* lead */
    font-weight: 400;
    line-height: 1.4;
    max-width: 800px;
    margin: 0;
  }

  .gallery-section {
    background-color: var(--canvas);
    padding: var(--spacing-section) 0;
  }

  .back-link {
    margin-top: 48px;
    text-align: left;
  }

  .btn-secondary {
    display: inline-block;
    padding: 10px 16px;
    background-color: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: var(--rounded-xs);
    font-weight: 500;
    font-size: 14px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn-secondary:hover {
    background-color: rgba(0,0,0,0.05);
  }
</style>