---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';

const photos = [
  { id: 1, url: 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=800&q=80', alt: 'Wedding Reception' },
  { id: 2, url: 'https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=800&q=80', alt: 'Corporate Event' },
  { id: 3, url: 'https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?w=800&q=80', alt: 'Event Celebration' },
  { id: 4, url: 'https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?w=800&q=80', alt: 'Gala Dinner' },
  { id: 5, url: 'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=800&q=80', alt: 'Nightlife Vibe' },
  { id: 6, url: 'https://images.unsplash.com/photo-1528605248644-14dd04022da1?w=800&q=80', alt: 'Birthday Party' },
];
---

<Layout>
  <section class="hero">
    <div class="container">
      <h1>Private Events</h1>
      <div class="hero-rule"></div>
      <p>Elegant and candid moments from weddings, galas, and exclusive parties.</p>
    </div>
  </section>

  <section class="gallery-section">
    <div class="container">
      <Gallery photos={photos} />

      <div class="back-link">
        <a href="/" class="btn btn-secondary">Back to Home</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 5%;
  }

  .hero {
    background-color: var(--canvas-warm);
    padding: var(--spacing-section) 0;
  }

  .hero h1 {
    font-family: 'Georgia', serif;
    font-size: 56px; /* display-serif-xl */
    font-weight: 400;
    margin-bottom: 24px;
    line-height: 1.2;
  }

  .hero-rule {
    width: 40px;
    height: 4px;
    background-color: var(--accent-gold);
    margin-bottom: 24px;
  }

  .hero p {
    font-size: 24px; /* lead */
    font-weight: 400;
    line-height: 1.4;
    max-width: 800px;
    margin: 0;
  }

  .gallery-section {
    background-color: var(--canvas);
    padding: var(--spacing-section) 0;
  }

  .back-link {
    margin-top: 48px;
    text-align: left;
  }

  .btn-secondary {
    display: inline-block;
    padding: 10px 16px;
    background-color: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: var(--rounded-xs);
    font-weight: 500;
    font-size: 14px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn-secondary:hover {
    background-color: rgba(0,0,0,0.05);
  }
</style>